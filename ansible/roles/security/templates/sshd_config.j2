# Managed by Ansible - do not edit manually
Port {{ security_ssh_port }}
Protocol 2

PermitRootLogin {{ 'no' if security_disable_root_login else 'yes' }}
PasswordAuthentication {{ 'no' if security_disable_password_auth else 'yes' }}
PubkeyAuthentication yes
ChallengeResponseAuthentication no
UsePAM yes

X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*

MaxAuthTries 3
ClientAliveInterval 300
ClientAliveCountMax 2

Subsystem sftp /usr/lib/openssh/sftp-server
